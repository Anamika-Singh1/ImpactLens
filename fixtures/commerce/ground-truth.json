{
  "version": 1,
  "features": [
    { "id": "authentication", "name": "Authentication", "entry": "src/routes/authentication.js", "test": "tests/authentication.test.js" },
    { "id": "catalog", "name": "Product catalog", "entry": "src/routes/catalog.js", "test": "tests/catalog.test.js" },
    { "id": "cart", "name": "Cart", "entry": "src/routes/cart.js", "test": "tests/cart.test.js" },
    { "id": "checkout", "name": "Checkout", "entry": "src/routes/checkout.js", "test": "tests/checkout.test.js" },
    { "id": "orders", "name": "Order history", "entry": "src/routes/orders.js", "test": "tests/orders.test.js" }
  ],
  "scenarios": [
    { "id": "shared-auth", "split": "development", "expected": ["authentication", "cart", "checkout", "orders"], "reason": "All four protected user journeys use authentication middleware; catalog is public.", "edits": [{ "path": "src/auth.js", "from": "req.user = { id: 'user-1' };", "to": "req.user = { id: 'user-1', authenticated: true };" }] },
    { "id": "checkout-only", "split": "development", "expected": ["checkout"], "reason": "Only checkout's response contract gains a receipt flag.", "edits": [{ "path": "src/checkout.js", "from": "status: 'paid'", "to": "status: 'paid', receipt: true" }] },
    { "id": "unrelated-component", "split": "development", "expected": [], "reason": "Badge is not rendered or imported by any of the five business journeys.", "edits": [{ "path": "src/ui/Badge.js", "from": "Synthetic commerce fixture", "to": "Owned benchmark fixture" }] },
    { "id": "rename-cart", "split": "development", "expected": ["cart"], "reason": "Moving the cart implementation and its import affects only the cart module boundary.", "rename": { "from": "src/cart.js", "to": "src/cart-items.js" }, "edits": [{ "path": "src/routes/cart.js", "from": "../cart.js", "to": "../cart-items.js" }] },
    { "id": "pricing-cycle", "split": "development", "expected": ["checkout"], "reason": "A cycle in checkout pricing and rounding does not enter other journeys.", "edits": [{ "path": "src/pricing.js", "from": "export function total(price, quantity) { return price * quantity; }", "to": "import { round } from './rounding.js';\nexport function total(price, quantity) { return round(price * quantity); }" }], "add": { "src/rounding.js": "import { total } from './pricing.js';\nexport function round(value) { return Math.round(value); }\nexport function preview(price) { return total(price, 1); }\n" } },
    { "id": "dynamic-discount", "split": "development", "expected": ["checkout"], "reason": "Checkout loads discount by a computed dynamic import. Changing the plugin changes its runtime total despite no literal dependency edge.", "baseEdits": [{ "path": "src/checkout.js", "from": "export function checkout(req, res)", "to": "export async function checkout(req, res)" }, { "path": "src/checkout.js", "from": "total: total(price, quantity)", "to": "total: (await import('./' + 'discount.js')).discount(total(price, quantity))" }], "edits": [{ "path": "src/discount.js", "from": "return value;", "to": "return value - 100;" }], "knownFailures": ["known-checkout-total"] },
    { "id": "delete-orders", "split": "held-out", "expected": ["orders"], "reason": "Removing order history's implementation and registration removes the order journey.", "delete": ["src/orders.js", "src/routes/orders.js"], "edits": [{ "path": "src/app.js", "from": "import { orderRoutes } from './routes/orders.js';", "to": "" }, { "path": "src/app.js", "from": " orderRoutes(app);", "to": "" }], "knownFailures": ["known-orders-user-scope"] },
    { "id": "auth-bypass-bug", "split": "held-out", "expected": ["authentication", "cart", "checkout", "orders"], "reason": "Removing the common authentication check exposes all protected journeys.", "edits": [{ "path": "src/auth.js", "from": "if (req.headers.authorization !== 'Bearer fixture-user') return res.sendStatus(401);", "to": "// Deliberate benchmark bug: anonymous requests accepted." }], "knownFailures": ["known-auth-rejects-anonymous"] },
    { "id": "checkout-arithmetic-bug", "split": "held-out", "expected": ["checkout"], "reason": "Addition instead of multiplication changes only checkout totals.", "edits": [{ "path": "src/pricing.js", "from": "price * quantity", "to": "price + quantity" }], "knownFailures": ["known-checkout-total"] },
    { "id": "catalog-price-bug", "split": "held-out", "expected": ["catalog", "cart"], "reason": "Product data is consumed by the public catalog and cart product validation; checkout accepts its independent input price.", "edits": [{ "path": "src/catalog.js", "from": "price: 1200", "to": "price: -1200" }], "knownFailures": ["known-catalog-price"] }
  ]
}
