generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// Repository import arrives in a later phase; this table is intentionally empty.
model Repository {
  id        String   @id @default(uuid()) @db.Uuid
  owner     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([owner, name])
}
