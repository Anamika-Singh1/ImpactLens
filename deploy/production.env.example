# Copy to deploy/production.env (ignored). Supply real private service URLs and HTTPS origin.
WEB_ORIGIN=https://impactlens.example.com
DATABASE_URL=postgresql://impactlens:replace_password@private-postgres:5432/impactlens?schema=public&connect_timeout=3&pool_timeout=3&socket_timeout=3
REDIS_URL=redis://private-redis:6379
LOG_LEVEL=info
SESSION_TTL_HOURS=24
# Explicit private reverse-proxy subnet only. Empty means no forwarded-header trust.
TRUSTED_PROXIES=
GITHUB_ENABLED=false
AI_PROVIDER=disabled
